# Salin ke .env lalu isi

# Broker MQTT
MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USER=backend
MQTT_PASS=ganti-password-ini

# Firebase: unduh kunci akun layanan di Firebase Console > Setelan proyek > Akun layanan.
# Simpan di folder backend, jangan di-commit.
FIREBASE_KREDENSIAL=./kunci-firebase.json
EMAIL_OPERATOR=operator@toren-tuban.id   # harus sama dengan VITE_EMAIL_OPERATOR di aplikasi

# Telegram
TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890      # grup pengelola

# Ambang alarm
AMBANG_MALAM_LPM=2                   # aliran rata-rata 01.00-04.00 di atas ini = indikasi bocor
AMBANG_LONJAKAN_PERSEN=150           # total harian > 150% rata-rata 7 hari
AMBANG_NOL_JAM=3                     # aliran nol selama ini di siang hari (06-18) = tandon kosong
AMBANG_AKI_V=11.5                    # tegangan aki rendah
AMBANG_OFFLINE_MENIT=45              # tidak ada paket selama ini = perangkat offline
AMBANG_NERACA_PERSEN=4               # selisih neraca harian (masuk - keluar - perubahan toren) yang masih wajar
AMBANG_NERACA_MIN_L=100              # selisih di bawah ini diabaikan
AMBANG_BOCOR_MALAM_L=20              # level turun per jam saat pompa mati dan tidak ada aliran = toren bocor
AMBANG_LUBER_PERSEN=97               # toren dianggap penuh
TZ=Asia/Jakarta

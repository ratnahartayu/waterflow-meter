# Tidak wajib saat sudah di Firebase Hosting: konfigurasi diambil otomatis dari /__/firebase/init.json.
# Isi bila menjalankan "npm run dev" di komputer sendiri (salin dari Firebase Console > Setelan proyek > Aplikasi web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Akun operator yang dibuat oleh backend/src/siapkan-firebase.js
VITE_EMAIL_OPERATOR=operator@toren-tuban.id
